{
  "name": "medigital-dev/ci4-base",
  "description": "Base model dan util reusable untuk project CodeIgniter 4",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.4"
  },
  "autoload": {
    "psr-4": {
      "MedigitalDev\\Ci4Base\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3"
  },
  "autoload-dev": {
